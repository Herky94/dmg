{
  "kind": "collectionType",
  "collectionName": "prodottos",
  "info": {
    "singularName": "prodotto",
    "pluralName": "prodottos",
    "displayName": "Prodotto"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Slug": {
      "type": "uid",
      "targetField": "Name"
    },
    "Name": {
      "type": "string"
    },
    "sottotitolo": {
      "type": "string"
    },
    "Description": {
      "type": "blocks"
    },
    "Indicazione": {
      "type": "blocks"
    },
    "posologiaModoDuso": {
      "type": "blocks"
    },
    "formulazioni": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::formulazione.formulazione",
      "inversedBy": "prodottos"
    },
    "classificazioni": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::classificazioni.classificazioni",
      "inversedBy": "prodottos"
    },
    "aree_terapeutiche": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::aree-terapeutiche.aree-terapeutiche",
      "inversedBy": "prodottos"
    },
    "Mercato": {
      "type": "string"
    },
    "Images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "video": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "PDF": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "altreFormulazioni": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::prodotto.prodotto",
      "inversedBy": "collegatoA"
    },
    "collegatoA": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::prodotto.prodotto",
      "mappedBy": "altreFormulazioni"
    }
  }
}
