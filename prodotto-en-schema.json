      "relation": "manyToMany",
      "target": "api::formulazione.formulazione",
      "inversedBy": "prodotto_ens"
    },
    "classificazioni": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::classificazioni.classificazioni",
